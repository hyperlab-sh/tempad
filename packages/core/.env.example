# Copy to $TEMPAD_HOME/.env (default ~/.tempad/.env), or let `tempad init` write it.
# Each command checks only the variables it needs; the commands that need each
# variable are listed after it. Real environment variables win over this file.

# Monday.com API token (secret).  Needed by: sync monday
MONDAY_API_TOKEN=
# Your Monday.com user: numeric id or display name.  Needed by: sync monday
MONDAY_USER=

# Your GitHub login.  Needed by: sync github
GH_USER=
# Comma-separated GitHub organizations to mirror, e.g. my-org,other-org.  Needed by: sync github
GH_ORGS=
# Also mirror your personal repositories: true or false.  Needed by: sync github
GH_INCLUDE_PERSONAL=
# Optional: GitHub token (secret). When blank, `gh auth` credentials are used.  Used by: sync github
GH_TOKEN=
# Comma-separated commit author emails that count as yours.  Needed by: sync github
GIT_AUTHOR_EMAILS=

# Comma-separated Claude Code config directories holding projects/*.jsonl, e.g. ~/.claude.
# Needed by: sync claude, w5 run
CLAUDE_DIRS=
# Short name for this machine, stored with every Claude session.  Needed by: sync claude, w5 run
HOST_SLUG=

# IANA time zone that places work on days, e.g. Europe/Berlin.  Needed by: report *, w5 eval
TZ=
# Earliest date to sync, YYYY-MM-DD.  Needed by: sync github, sync claude
SINCE=
